<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.launcher3">

    <PreferenceCategory
        android:title="@string/general_category_title">

        <ListPreference
            android:key="pref_recents_style"
            android:title="@string/recents_style_title"
            android:summary="%s"
            android:entries="@array/recents_style_entries"
            android:entryValues="@array/recents_style_values"
            android:defaultValue="default"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="pref_recents_meminfo"
            android:title="@string/recents_meminfo_title"
            android:defaultValue="false"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

        <Preference
            android:key="recents_privacy_apps"
            android:title="@string/recents_privacy_title"
            android:summary="@string/recents_privacy_summary"
            launcher:iconSpaceReserved="false">
            <intent
                android:action="android.intent.action.APPLICATION_PREFERENCES"
                android:targetPackage="com.android.launcher3"
                android:targetClass="com.android.launcher3.settings.RecentsPrivacySettings" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/actions_category_title">

        <SwitchPreferenceCompat
            android:key="pref_recents_screenshot"
            android:title="@string/recents_screenshot_title"
            android:defaultValue="true"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="pref_recents_lens"
            android:title="@string/recents_lens_title"
            android:defaultValue="false"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="pref_recents_clear_all"
            android:title="@string/recents_clear_all_title"
            android:defaultValue="true"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
